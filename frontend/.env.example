# Where the backend is listening. Copy this file to .env.local and edit if needed.
#
#   docker compose up   -> http://localhost:5080   (the default; no .env.local needed)
#   dotnet run          -> http://localhost:5246   (the API's http launch profile)
#
# Check the "Now listening on:" line the API prints at startup if you are unsure.
VITE_API_URL=http://localhost:5080
