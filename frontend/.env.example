# Optional. Only needed when your backend is not on the default port.
#
# Copy this file to .env.local (git-ignored) and set the port the API printed
# at startup:
#
#   Visual Studio, debug (F5)   http://localhost:5246   <- the default already
#   docker compose up           http://localhost:5080
#
# Restart `npm run dev` after changing it.
VITE_API_URL=http://localhost:5246
