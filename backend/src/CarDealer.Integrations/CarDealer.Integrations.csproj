<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integrations hosts external provider adapters (master prompt section 6).

    Hosts the Carapis adapter. Vendor wire types stay internal to this project; callers
    depend on the IVehicleSourceProvider family in Application, which is what keeps
    acceptance criterion H6 true - no vendor SDK type reaches Application or Domain.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarDealer.Application\CarDealer.Application.csproj" />
    <ProjectReference Include="..\CarDealer.Domain\CarDealer.Domain.csproj" />
  </ItemGroup>

</Project>
