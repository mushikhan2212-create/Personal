# Copy to backend/.env (git-ignored) and fill in. docker compose reads this file
# automatically; every value here is optional and has a development default.

# Carapis API key. Without it the platform runs normally with synchronization disabled -
# the sync endpoint answers 503 and search over already-synced data is unaffected.
# Never put this in appsettings*.json: those are committed.
CARAPIS_API_KEY=

# The AI ranking provider. Leave these unset and the feature falls back to price order and says
# so on screen - a working product, so fill them in when you are ready rather than before.
#
# Put real values in backend/.env, never here: THIS file is committed and backend/.env is not.
# Choosing a model is a measurement, not a guess - see docs/spec/11-ai-provider-setup.md.
#
# AI__Provider=groq
# AI__Model=<the model id, exactly as the provider spells it>
# AI__ApiKey=<your key>
# AI__BaseUrl=              # leave unset for Groq; needed for other OpenAI-shaped hosts
# AI__MaxCandidates=8       # cars sent per ranking - size it to your rate limit
# AI__MaxTokens=900

# Overrides for the local development defaults. Fine to leave unset.
# MSSQL_SA_PASSWORD=
# JWT_SIGNING_KEY=
